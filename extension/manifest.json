{
  "manifest_version": 3,
  "name": "iVelt Helper v2",
  "description": "Adds accessibility and usability improvements to אייוועלט.",
  "version": "2.6.1",
  "key": "",
  "icons": {
    "48": "img/icon48.png",
    "128": "img/icon128.png"
  },
  "action": {
    "default_icon": {
      "48": "img/icon48.png",
      "128": "img/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ivelt.com/*",
        "*://*.yiddishworld.com/*",
        "*://*.198.153.76.147/*"
      ],
      "css": ["css/themes.css"],
      "js": ["js/themes.data.js", "js/theme.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.ivelt.com/*",
        "*://*.yiddishworld.com/*",
        "*://*.198.153.76.147/*"
      ],
	  "css":["css/appcss.css"],
      "js": [
        "js/settingsHandler.js",
        "js/contentScript.js",
        "js/refreshNotificationCount.js"
      ]
    },
    {
      "matches": [
        "*://*.ivelt.com/forum/posting.php*",
        "*://*.yiddishworld.com/forum/posting.php*",
        "*://*.198.153.76.147/forum/posting.php*"
      ],
      "css": ["css/imageResizer.css", "css/driveUpload.css"],
      "js": ["js/imageResizer.js", "js/driveUpload.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html",
  "permissions": [
    "alarms",
    "identity",
    "cookies",
    "storage",
    "notifications",
    "background",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback"
  ],
  "host_permissions": [
    "*://*.ivelt.com/*",
    "*://*.198.153.76.147/*",
    "*://*.yiddishworld.com/*",
    "*://www.xn--4dbhss5b.com/*",
    "https://docs.google.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "js/keyboardShortcuts.js",
        "js/newResponseNotification.js",
        "js/addGoogleSearch.js",
        "js/pageEnhancements.js",
        "js/splitNotifications.js",
		"js/addTopicButtons.js",
        "js/settingsHandler.js",
        "js/print.js"
      ],
      "matches": [
        "*://*.ivelt.com/*",
        "*://*.yiddishworld.com/*",
        "*://*.198.153.76.147/*"
      ],
      "extension_ids": []
    }
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
